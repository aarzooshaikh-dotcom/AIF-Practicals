R = [[0.2, 0.5],
     [0.7, 0.4]]
S = [[0.6, 0.8],
     [0.3, 0.9]]
T = [[0,0],
     [0,0]]
for i in range(2):
    for j in range(2):
        values = []
        for k in range (2):
            values.append(max(R[i][k], S[k][j]))
            T[i][j] = min(values)
print("Min-Max Composition:")
for row in T:
    print(row)
